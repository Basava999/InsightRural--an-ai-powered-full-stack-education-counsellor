# InsightRural Environment Configuration
# Copy this file to .env and fill in your values

# Ollama Local Model Config
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional API Keys (Get free keys from respective provider portals)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=your_openai_api_key_here

SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-m

# Security & JWT Token Key
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
